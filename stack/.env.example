# 复制为 .env 后使用（init.sh 会自动复制并生成随机密码）。.env 不要提交到 Git。

# Dujiao-Next 镜像版本。线上建议固定版本号（如 v1.5.1），不要用 latest
TAG=latest
TZ=Asia/Shanghai

# 本机端口（只监听 127.0.0.1，线上由 Nginx 反代）
APP_PORT=8080
BEPUSDT_PORT=8090
BEPUSDT_TAG=latest

# 主题文件版本号：改了 theme/ 里的文件后 +1，再 docker compose up -d gateway
THEME_VERSION=1

# 初始管理员。密码留空 = 首次启动随机生成，只在日志里显示一次：
#   docker compose logs dujiao-next | grep -i password
DJ_DEFAULT_ADMIN_USERNAME=admin
DJ_DEFAULT_ADMIN_PASSWORD=

# Redis 密码（config.yml 的 redis 部分要填同一个）
REDIS_PASSWORD=change-me

# 备份（仅线上用）：rclone 远端，如 Cloudflare R2；加密口令务必另外保存
BACKUP_REMOTE=r2:shuweicao-backup
BACKUP_PASSPHRASE=change-me
